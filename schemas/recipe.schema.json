{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TPU-MLIR conversion recipe",
  "type": "object",
  "required": ["model_name", "input_name", "input_layout", "input_shape", "color", "mean", "std"],
  "properties": {
    "model_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "input_name": {"type": "string", "minLength": 1},
    "input_layout": {"enum": ["NCHW"]},
    "input_shape": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "integer", "minimum": 1}
    },
    "color": {"enum": ["RGB", "BGR"]},
    "mean": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "std": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0}},
    "resize": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["letterbox", "stretch"]},
        "pad_value": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "output_names": {"type": "array", "items": {"type": "string"}},
    "quantize_table": {"type": "string"},
    "chip": {"type": "string"},
    "input_num": {"type": "integer", "minimum": 1}
  }
}