{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "reCamera demo stage report",
  "type": "object",
  "required": ["schema_version", "kind", "generated_at", "stages"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "demo": {"type": ["string", "null"]},
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"enum": ["passed", "failed", "not_run", "unverified"]},
          "detail": {"type": "string"},
          "evidence": {"type": "object"}
        }
      }
    },
    "details": {"type": "object"}
  }
}